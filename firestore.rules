rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(deviceId) {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    // Users collection
    match /users/{deviceId} {
      // Allow read if authenticated and owns the document
      allow read: if isAuthenticated() && request.auth.uid == resource.data.uid;

      // Allow create if authenticated (for first-time setup)
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.uid &&
                       deviceId == request.resource.data.deviceId;

      // Allow update if authenticated and owns the document
      allow update: if isAuthenticated() && request.auth.uid == resource.data.uid;

      // Never allow delete (for safety - users can disable alerts instead)
      allow delete: if false;

      // Subcollection for check-in history (optional)
      match /checkIns/{checkInId} {
        allow read, write: if isAuthenticated() &&
                              request.auth.uid == get(/databases/$(database)/documents/users/$(deviceId)).data.uid;
      }
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
